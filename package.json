{
  "name": "steam-hour-booster",
  "version": "3.2.0",
  "description": "Farm your in-game hours on Steam",
  "author": {
    "email": "drwarpman@gmail.com",
    "name": "DrWarpMan"
  },
  "repository": "DrWarpMan/steam-hour-booster",
  "keywords": [
    "steam",
    "hour",
    "booster",
    "farmer",
    "idler",
    "idle",
    "farming",
    "hours"
  ],
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun .",
    "dev": "bun --watch .",
    "validate": "bun src/cli/validate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "check": "bun run typecheck && bun run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/bun": "^1.0.7",
    "@tsconfig/strictest": "^2.0.5",
    "@types/steam-user": "5.1.0",
    "@types/bun": "^1.2.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "p-retry": "^6.2.1",
    "steam-user": "^5.2.3",
    "zod": "^3.25.30"
  }
}