CONFIG_PATH=./config.json
STEAM_DATA_DIRECTORY=./steam-data
TOKEN_STORAGE_DIRECTORY=./tokens

# Monitor API
MONITOR_ENABLED=true
MONITOR_PORT=5000
MONITOR_HOST=127.0.0.1
# When set, all endpoints except /healthz require `Authorization: Bearer <token>`
MONITOR_TOKEN=

# How often the dashboard refreshes, in milliseconds
MONITOR_POLL_INTERVAL=5000

# Logging: debug | info | warn | error
LOG_LEVEL=info
# Force plain output even on a terminal
NO_COLOR=

# Set to 1 for the full Steam protocol trace
STEAM_DEBUG=

# Minutes between re-asserting the playing state (0 disables)
PLAY_KEEPALIVE=15

# Minutes between uptime log lines when not attached to a terminal
UPTIME_LOG_INTERVAL=5
